#include <winver.h>

/* File version must be >= 1.0.0.36 or CChromaEditorLibrary rejects the SDK DLL
 * as an old version and refuses to load it. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,20,0,0
 PRODUCTVERSION 3,20,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Razer Inc."
            VALUE "FileDescription", "Razer Chroma SDK"
            VALUE "FileVersion", "3.20.0.0"
            VALUE "InternalName", "RzChromaSDK64"
            VALUE "OriginalFilename", "RzChromaSDK64.dll"
            VALUE "ProductName", "Razer Chroma SDK"
            VALUE "ProductVersion", "3.20.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
