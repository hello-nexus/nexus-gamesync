#include <winver.h>

/* CompanyName "Nexus" is the cross-component ownership marker: the nexus-service
 * installer claims these DLLs by CompanyName == "Nexus". */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nexus"
            VALUE "FileDescription", "Nexus Game Sync (Logitech)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "LogitechLedEnginesWrapper"
            VALUE "OriginalFilename", "LogitechLedEnginesWrapper.dll"
            VALUE "ProductName", "Nexus Game Sync"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
